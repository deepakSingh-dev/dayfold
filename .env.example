# ============================================================================
# Dayfold environment. Copy this file to `.env` at the repo root:
#     cp .env.example .env
# Every service (web, sync, docker-compose, drizzle) reads this one file.
# ============================================================================

# --- Postgres (used by docker-compose to provision the DB) ------------------
POSTGRES_USER=dayfold
POSTGRES_PASSWORD=dayfold
POSTGRES_DB=dayfold
POSTGRES_PORT=5432

# --- Database connection (used by the web app, migrations, seed) ------------
# Host is localhost because the web app runs on the host and connects to the
# port published by the postgres container.
DATABASE_URL=postgres://dayfold:dayfold@localhost:5432/dayfold

# --- Better Auth ------------------------------------------------------------
# Generate a strong secret for real use: `openssl rand -base64 32`
BETTER_AUTH_SECRET=dev-insecure-secret-change-me
BETTER_AUTH_URL=http://localhost:3000

# --- Public URLs (inlined into the client bundle) ---------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SYNC_URL=http://localhost:1234

# --- Sync service -----------------------------------------------------------
SYNC_PORT=1234
SYNC_HOST=0.0.0.0
# The web app calls the sync service's internal endpoints at this URL.
SYNC_INTERNAL_URL=http://localhost:1234
# Shared secret used to sign short-lived doc tokens and authenticate internal
# calls between web and sync. Generate a strong value for real use.
SYNC_SHARED_SECRET=dev-insecure-sync-secret-change-me

# --- Google OAuth (OPTIONAL) ------------------------------------------------
# Leave blank to run with email/password only. Set both to enable Google login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- File uploads -----------------------------------------------------------
# Local disk path for attachment storage (abstracted behind storage.ts).
UPLOAD_DIR=./uploads
