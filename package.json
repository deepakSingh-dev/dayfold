{
  "name": "dayfold",
  "version": "0.1.0",
  "private": true,
  "description": "Dayfold — Asana + Notion in one app",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev --workspace @dayfold/web",
    "dev:web": "npm run dev --workspace @dayfold/web",
    "dev:sync": "npm run dev --workspace @dayfold/sync",
    "build": "npm run build --workspace @dayfold/web",
    "start": "npm run start --workspace @dayfold/web",
    "db:generate": "npm run db:generate --workspace @dayfold/web",
    "db:migrate": "npm run db:migrate --workspace @dayfold/web",
    "db:seed": "npm run db:seed --workspace @dayfold/web",
    "db:studio": "npm run db:studio --workspace @dayfold/web",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"**/*.{js,jsx,mjs,cjs,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,mjs,cjs,json,md,css}\"",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.11"
  }
}
